# Variáveis da suíte KAPTEK. Copie para suite/.env e ajuste. Nunca versione o .env.
# "dev" liga a documentação da API (/docs). Em produção deixe producao (o padrão).
SUITE_AMBIENTE=dev
SUITE_BANCO_URL=postgresql+psycopg://suite:suite@localhost:5432/suite
# Segredo da sessão: mínimo de 32 caracteres. Troque em produção.
SUITE_SEGREDO_SESSAO=desenvolvimento-troque-este-segredo-em-producao-0123456789
SUITE_SESSAO_HORAS=12
# Em produção (HTTPS) deixe true.
SUITE_COOKIE_SEGURO=false
SUITE_S3_ENDPOINT=http://localhost:9000
SUITE_S3_ENDPOINT_PUBLICO=http://localhost:9000
SUITE_S3_REGIAO=us-east-1
SUITE_S3_BALDE=suite
# Chave de acesso do S3. Troque em produção.
SUITE_S3_CHAVE=suite-dev-chave
# Segredo do S3. Troque em produção.
SUITE_S3_SEGREDO=suite-dev-segredo
SUITE_URL_ASSINADA_SEGUNDOS=300
SUITE_ARQUIVO_MAX_BYTES=26214400
SUITE_WORKER_INTERVALO_S=2.0
# Senha dos usuários de demonstração (comando semear-demo). Só para desenvolvimento.
SUITE_SEMENTE_SENHA=
