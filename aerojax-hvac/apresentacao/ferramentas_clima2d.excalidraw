   "text": "fig, ax = plt.subplots()\nax.imshow(T.T, origin=\"lower\", cmap=\"coolwarm\")\nax.streamplot(x, y, u, v)\nfig.savefig(\"sala.png\")",
   "fontSize": 20,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "fig, ax = plt.subplots()\nax.imshow(T.T, origin=\"lower\", cmap=\"coolwarm\")\nax.streamplot(x, y, u, v)\nfig.savefig(\"sala.png\")",
