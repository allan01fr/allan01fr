   "text": "T[i, j] = temperatura da célula (i, j)\nna simulação real: 50 × 28 = 1.400 células",
   "fontSize": 22,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "T[i, j] = temperatura da célula (i, j)\nna simulação real: 50 × 28 = 1.400 células",
   "autoResize": true,
   "lineHeight": 1.35
  },
  {
