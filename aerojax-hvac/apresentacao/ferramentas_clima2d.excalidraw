   "text": "import jax\nf = lambda t: psi.umidade_relativa(t, 0.010)\njax.grad(f)(24.0)   # → -0.032\n# a UR cai 3,2 % por °C de aquecimento",
   "fontSize": 21,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "import jax\nf = lambda t: psi.umidade_relativa(t, 0.010)\njax.grad(f)(24.0)   # → -0.032\n# a UR cai 3,2 % por °C de aquecimento",
   "autoResize": true,
   "lineHeight": 1.2
  },
