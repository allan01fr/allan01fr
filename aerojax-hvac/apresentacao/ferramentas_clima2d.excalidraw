  {
   "id": "s3_t25",
   "type": "text",
   "x": 5950,
   "y": 269.6,
   "width": 627.5390625,
   "height": 100.8,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "s3_g24"
   ],
   "frameId": "frame3",
   "index": "b0Q",
   "roundness": null,
   "seed": 1510285435,
   "version": 2,
   "versionNonce": 600404629,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791304172049,
   "link": null,
   "locked": false,
   "text": "import numpy as np\nT = np.full((50, 28), 24.0)  # sala inteira a 24 °C\nT[:, 0] -= 2                 # piso 2 °C mais frio\nmedia = T.mean()             # uma linha, sem laço",
   "fontSize": 21,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "import numpy as np\nT = np.full((50, 28), 24.0)  # sala inteira a 24 °C\nT[:, 0] -= 2                 # piso 2 °C mais frio\nmedia = T.mean()             # uma linha, sem laço",
   "autoResize": true,
   "lineHeight": 1.2
  },
